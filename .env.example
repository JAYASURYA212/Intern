# Database Configuration (Optional for MySQL - defaults to embedded H2 for instant run)
DB_URL=jdbc:mysql://localhost:3306/mobilemart_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# JWT Authentication
JWT_SECRET=MobileMartSecretKeyForJwtSigningMustBeVeryLongAndSecure1234567890!
JWT_EXPIRATION_MS=86400000

# Cloudinary Storage Configuration (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Shop Contact
SHOP_WHATSAPP_NUMBER=+919876543210
SHOP_PHONE_NUMBER=+919876543210
